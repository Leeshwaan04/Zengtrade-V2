# zengtrade worker — copy to .env and fill in. NEVER commit .env.
# Supabase Postgres connection string: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> "URI" (use the SESSION pooler on :5432, or direct). Password = the DB
# password you ROTATED. URL-encode any special chars in the password.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# how often to run a live cycle, seconds (default 300 = 5 min)
WORKER_INTERVAL=300
